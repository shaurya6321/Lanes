{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/hooks/session_start.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/hooks/pre_tool_guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/hooks/post_tool_notice.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/hooks/stop_summary.py"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
